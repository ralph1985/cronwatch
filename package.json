{
  "name": "cronwatch",
  "version": "0.1.0",
  "private": true,
  "description": "Informe diario de copias de seguridad de cron y timers systemd mediante Resend.",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/cli.ts run",
    "collect": "tsx src/cli.ts collect",
    "install:cron": "tsx src/cli.ts install-cron",
    "verify-codex": "tsx src/cli.ts verify-codex",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": { "node": ">=22" },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
