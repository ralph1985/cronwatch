{
  "name": "cronwatch",
  "version": "0.1.0",
  "private": true,
  "description": "Informe diario de cron, timers systemd y sus logs con Codex y Resend.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/cli.ts run",
    "collect": "tsx src/cli.ts collect",
    "install:cron": "tsx src/cli.ts install-cron",
    "verify-codex": "tsx src/cli.ts verify-codex",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": { "node": ">=22" },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
