# Resend
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=CronWatch <cronwatch@example.com>
REPORT_TO=you@example.com,another@example.com

# Optional operational settings
CRONWATCH_TIMEZONE=Europe/Madrid
CRONWATCH_SCHEDULE="0 8 * * *"
CRONWATCH_PROJECT_ROOT=/home/rafa/dev/cronwatch
CRONWATCH_DEV_ROOT=/home/rafa/dev
CRONWATCH_RETENTION_DAYS=30
CRONWATCH_LOG_MAX_BYTES=200000
CRONWATCH_CODEX_BIN=/home/rafa/.local/bin/codex
